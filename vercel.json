{
  "rewrites": [
    {
      "source": "/favicon.ico",
      "destination": "/api/icon?f=favicon.ico"
    },
    {
      "source": "/rc-logo.png",
      "destination": "/api/icon?f=rc-logo.png"
    },
    {
      "source": "/icon-16.png",
      "destination": "/api/icon?f=icon-16.png"
    },
    {
      "source": "/icon-32.png",
      "destination": "/api/icon?f=icon-32.png"
    },
    {
      "source": "/icon-48.png",
      "destination": "/api/icon?f=icon-48.png"
    },
    {
      "source": "/icon-180.png",
      "destination": "/api/icon?f=icon-180.png"
    },
    {
      "source": "/icon-192.png",
      "destination": "/api/icon?f=icon-192.png"
    },
    {
      "source": "/icon-512.png",
      "destination": "/api/icon?f=icon-512.png"
    },
    {
      "source": "/apple-touch-icon.png",
      "destination": "/api/icon?f=apple-touch-icon.png"
    },
    {
      "source": "/admin",
      "destination": "/admin.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self' 'unsafe-inline' https://cdn.jsdelivr.net; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https:; font-src 'self' data:; connect-src 'self' https://api.mainnet-beta.solana.com wss://api.mainnet-beta.solana.com; frame-ancestors 'none'; base-uri 'self'; form-action 'self'; object-src 'none'"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "no-referrer"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=(), payment=()"
        }
      ]
    },
    {
      "source": "/admin(.html)?",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        },
        {
          "key": "Cache-Control",
          "value": "no-store"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Referrer-Policy",
          "value": "no-referrer"
        }
      ]
    }
  ]
}
